# Copie este arquivo para .env e preencha. O .env não vai para o git.

# Chave das sessões: uma sequência longa e aleatória, por exemplo a saída de
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Primeiro administrador, criado só quando o banco ainda não tem usuário.
# Sem ADMIN_SENHA (ou com menos de 6 caracteres), o sistema gera uma senha
# aleatória e a mostra no console uma única vez.
ADMIN_EMAIL=admin@example.com
ADMIN_SENHA=

# Rede: 0.0.0.0 (padrão) deixa os outros computadores da rede abrirem o
# sistema; 127.0.0.1 restringe a esta máquina.
HOST=0.0.0.0
PORT=5000

# Fuso do envio diário dos alertas (padrão America/Bahia).
ALERTSIGNAL_FUSO=America/Bahia

# 1 quando o sistema estiver atrás de HTTPS: o cookie de sessão passa a
# trafegar só por HTTPS.
ALERTSIGNAL_HTTPS=0
